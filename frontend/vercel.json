{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/build"
      }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/marketing-app",
      "dest": "/frontend/build/index.html"
    },
    {
      "src": "/marketing-app/(.*)",
      "dest": "/frontend/build/index.html"
    }
  ]
}
